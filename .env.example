# ==========================================================
# Aaharika Catering — Environment Variables (EXAMPLE)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to Git.
# ==========================================================

# --- Turso Database (database name: Aaharika_Catering) ---
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Authentication ---
# Generate a strong secret, e.g. `openssl rand -base64 32`
JWT_SECRET=replace-with-a-long-random-secret-string

# --- Email (Gmail SMTP via nodemailer) ---
# For Gmail use an App Password (not your normal password).
EMAIL_USER=your-business-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Where admin notification emails are delivered.
ADMIN_EMAIL=soumikmondal723@gmail.com

# --- Public site URL (used in emails / SEO) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
